      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Config (Broker)').first().json.wa_phone_number_id }}",
        "recipientPhoneNumber": "={{ $json.broker_phone }}",
        "textBody": "=✅ Your listing is live on Vulturus!\n\n*Listing ID:* {{ $json.listing_id }}\n*Property:* {{ $json.title }}\n*Location:* {{ $json.locality }}\n*Type:* {{ $json.property_type }}\n*BHK:* {{ $json.bhk || '-' }}\n*Price:* {{ $json.price_inr ? '₹' + Number($json.price_inr).toLocaleString('en-IN') : 'On request' }}\n\nBuyers on WhatsApp can now discover your property. We will notify you when a site visit is booked.\n\nThank you for listing with Vulturus! 🏡",
        "additionalFields": {}
      },
      "id": "46d50802-58ae-47e5-b8a7-a5fb173dd6d1",
      "name": "Notify Broker (Listing Live)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1104,
        64
      ],
      "credentials": {
