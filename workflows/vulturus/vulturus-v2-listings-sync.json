    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"city\": \"Pune\",\n  \"db_spreadsheet_id\": \"<BROKER_FORM_RESPONSES_SHEET_ID>\",\n  \"wa_phone_number_id\": \"<PHONE_NUMBER_ID>\"\n}",
